<view id="{{n}}" change:eS="{{uV.sS}}" eS="{{$eS[n]}}" change:eA="{{uV.sA}}" eA="{{$eA[n]}}" class="{{['container', virtualHostClass]}}" style="{{virtualHostStyle}}" hidden="{{virtualHostHidden || false}}"><view class="header"><text class="title">政策详细信息</text></view><view wx:if="{{a}}" class="content"><view class="info-section"><view class="info-row"><text class="info-label">政策名称：</text><text class="info-value">{{b}}</text></view><view class="info-row"><text class="info-label">发文字号：</text><text class="info-value">{{c}}</text></view><view class="info-row"><text class="info-label">制定机关：</text><text class="info-value">{{d}}</text></view><view class="info-row"><text class="info-label">颁布日期：</text><text class="info-value">{{e}}</text></view><view class="info-row"><text class="info-label">施行日期：</text><text class="info-value">{{f}}</text></view><view class="info-row"><text class="info-label">政策分类：</text><text class="info-value">{{g}}</text></view><view class="info-row"><text class="info-label">施行范围：</text><text class="info-value">{{h}}</text></view><view class="info-row"><text class="info-label">时效状态：</text><text class="{{['info-value', j]}}">{{i}}</text></view><view class="info-row"><text class="info-label">关键词：</text><text class="info-value">{{k}}</text></view></view><view class="content-section"><text class="section-title">政策正文</text><scroll-view class="content-scroll" scroll-y enable-flex="true" enhanced="true"><text class="content-text">{{l}}</text></scroll-view></view></view><view class="footer"><button class="btn-back" bindtap="{{m}}">返回列表</button></view></view><wxs src="/common/uniView.wxs" module="uV"/>
